{
  "name": "agent-ready-score",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-11-20",
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "assets": {
    "directory": "worker/public",
    "binding": "ASSETS"
  },
  // CTA events (see MEASUREMENT.md). Workers Analytics Engine is included in the Workers Free plan
  // (100k data points/day); the dataset is created on first write, nothing to provision.
  "analytics_engine_datasets": [
    { "binding": "EVENTS", "dataset": "agent_ready_events" }
  ]
  // Pro waitlist (free). Before enabling, run `npx wrangler kv namespace create WAITLIST`
  // and paste the id below. Until then /api/waitlist answers 503 "not open yet".
  // ,"kv_namespaces": [ { "binding": "WAITLIST", "id": "<paste-id>" } ]
}
